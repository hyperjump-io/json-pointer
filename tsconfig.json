{
  "exclude": ["./coverage", "./scratch", "./benchmark"],
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "strictNullChecks": true,
    "checkJs": true,
    "skipLibCheck": false,
    "skipDefaultLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"],
    // Remove once @stylistic/eslint-plugin fixes its "types" paths
    // (https://github.com/eslint-stylistic/eslint-stylistic/issues/1331).
    "paths": {
      "@stylistic/eslint-plugin": ["./node_modules/@stylistic/eslint-plugin/dist/dts/index.d.mts"]
    }
  }
}
